{
  "name": "gatsby-source-google-docs",
  "version": "2.4.10",
  "description": "Gatsby plugin to use Google Docs as a data source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/gatsby-source-google-docs.git"
  },
  "author": "Cédric Delpoux <cedric.delpoux@gmail.com>",
  "license": "MIT",
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source",
    "gatsby-source-plugin",
    "google",
    "google-docs",
    "docs",
    "drive"
  ],
  "main": "index.js",
  "files": [
    "index.d.ts",
    "gatsby-browser.js",
    "gatsby-node.js",
    "gatsby-ssr.js",
    "utils"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "gatsby": "^5.0.0"
  },
  "dependencies": {
    "@googleapis/docs": "^10.0.0",
    "@googleapis/drive": "^22.0.0",
    "dotenv": "^17",
    "gatsby-source-filesystem": "^5.16.0",
    "google-auth-library": "^10",
    "google-oauth2-env-vars": "^1.4.0",
    "json2md": "^2.0.0",
    "lodash": "^4.17.21",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^9",
    "@semantic-release/changelog": "^6",
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^12",
    "@semantic-release/npm": "^13",
    "@semantic-release/release-notes-generator": "^14",
    "commitizen": "^4",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jest": "^29",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9",
    "jest": "^30",
    "lint-staged": "^17",
    "prettier": "^3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semantic-release": "^25"
  },
  "bin": {
    "gatsby-source-google-docs-token": "utils/generate-token.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "/.claude/"
    ]
  },
  "scripts": {
    "cz": "git-cz",
    "lint": "eslint .",
    "test": "jest --coverage",
    "prepublishOnly": "yarn lint && yarn test",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "format": "prettier --write ."
  }
}
