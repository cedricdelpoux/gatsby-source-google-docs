{
  "name": "google-docs-sync-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "lint": "npm run build && npm run lint --workspaces --if-present && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "allowScripts": {
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
