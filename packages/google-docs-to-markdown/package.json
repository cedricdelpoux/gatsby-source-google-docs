{
  "name": "google-docs-to-markdown",
  "version": "1.0.1",
  "description": "Convert Google Docs to Markdown or MDX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/google-docs-sync.git",
    "directory": "packages/google-docs-to-markdown"
  },
  "author": "Cédric Delpoux <cedric.delpoux@gmail.com>",
  "license": "MIT",
  "keywords": [
    "google",
    "google-docs",
    "docs",
    "markdown",
    "mdx",
    "converter"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "types"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "json2md": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "allowScripts": {
    "fsevents": false
  }
}
