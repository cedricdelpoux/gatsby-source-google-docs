{
  "name": "gatsby-source-google-docs",
  "version": "3.1.0",
  "description": "Gatsby plugin to use Google Docs as a data source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/google-docs-to-markdown.git",
    "directory": "packages/gatsby-source-google-docs"
  },
  "author": "Cédric Delpoux <cedric.delpoux@gmail.com>",
  "license": "MIT",
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source",
    "gatsby-source-plugin",
    "google",
    "google-docs",
    "docs",
    "drive"
  ],
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "files": [
    "index.js",
    "gatsby-browser.js",
    "gatsby-node.mjs",
    "gatsby-ssr.js",
    "utils",
    "types"
  ],
  "bin": {
    "gatsby-source-google-docs-token": "utils/generate-token.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "gatsby": "^5.3.0"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "gatsby-source-filesystem": "^5.16.0",
    "google-docs-to-markdown": "^1.0.1",
    "lodash": "^4.18.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.8"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "allowScripts": {
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
